---
import BuildingItem from '../icons/Building.astro'
import CalendarItem from '../icons/Calendar.astro'
import InfoItem from '../icons/Info.astro'
import MapItem from '../icons/Map.astro'

interface Props {
    date: string
    location: string
    place: string
    title: string
}

const { 
    date, 
    location, 
    place,
    title
} = Astro.props
---

<span class="absolute flex items-center justify-center w-6 h-6 rounded-full -start-3 ring-1 ring-gray-800 bg-blue-300 text-gray-800 dark:ring-blue-700 dark:bg-white dark:text-blue-700">
    <CalendarItem class="size-4"/>
</span>

<time class="mb-1 text-base font-normal leading-none text-gray-800/80 dark:text-gray-300/80">
    {date}
</time>

<div class="mt-4 gap-6">
    <div class="shadow-grid-mini hover:shadow-grid-hover-mini dark:shadow-grid hover:dark:shadow-grid-hover group col-start-1 flex flex-col justify-center gap-y-3 border-[1px] border-[#212121] hover:border-blue-800 hover:dark:border-sky-400 backdrop-blur-sm bg-opacity-40 rounded-3xl">
        <h3 class="text-base lg:text-base xl:text-lg font-semibold text-gray-800/80 dark:text-sky-300 py-6 mt-1 mx-4 text-pretty group-hover:mx-6 duration-300">
            {title}
        </h3>
        <footer class="flex flew-row items-center justify-between w-full bg-sky-300 dark:bg-[#080c1c] text-[#080c1c] dark:text-sky-300 rounded-b-3xl ">
            <div class="w-full flex flex-col lg:flex-row items-start justify-between mx-3">
                <span class="text-pretty flex flex-row items-center justify-center p-1 gap-2 font-semibold" >
                    <BuildingItem class="size-6" /> 
                    {place}
                </span>

                <span class="text-pretty flex flex-row items-center justify-center p-1 gap-2 font-semibold" >
                    <MapItem class="size-6" /> 
                    {location}
                </span>
            </div>
        </footer> 
    </div>
</div>                                                              