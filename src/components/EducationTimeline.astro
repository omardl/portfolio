---
import LearningItem from "./EducationItem.astro"

import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const LEARNING = [
    {
        date: t('education.date.3'),
        location: t('education.location.3'),
        place: t('education.place.3'),
        title: t('education.title.3')
    },
    
    {
        date: t('education.date.2'),
        location: 'Vigo, Pontevedra',
        place: t('education.place.2'),
        title: t('education.title.2')
    },

    {
        date: t('education.date.1'),
        location: t('location.ourense'),
        place: 'CIFP A Farixa',
        title: t('education.title.1')
    },
]
---

<ol class="relative border-s border-gray-800 dark:border-gray-300 ml-3">   
    {
        LEARNING.map(learning => (
            <li class="mb-10 ms-6">  
                <LearningItem {... learning} />
            </li>    
        ))
    }            
</ol>